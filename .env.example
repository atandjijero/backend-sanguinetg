# --- Requis pour démarrer ---
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
JWT_ACCESS_SECRET=change-me-min-32-characters-long
JWT_REFRESH_SECRET=change-me-min-32-characters-long-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5371

# --- Email (Brevo SMTP) — optionnel, désactivé si absent ---
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=

# --- SMS (Brevo API) — optionnel, désactivé si absent ---
BREVO_API_KEY=
SMS_SENDER=

# --- Cloudinary (images de la page d'accueil) — optionnel ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Traduction DeepL (sélecteur de langue FR/EN) — optionnel ---
DEEPL_API_KEY=

# --- Notifications push (Web Push / VAPID) — optionnel, désactivé si absent ---
# Générer une paire de clés : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@cnts.tg
